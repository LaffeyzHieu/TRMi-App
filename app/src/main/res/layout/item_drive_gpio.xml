<?xml version="1.0" encoding="utf-8"?>
<!--
    Reusable list item for the Drive screen's 4 GPIO đang bật list.
    Each row: leading pause icon (using ic_tune per R7 user choice),
    headline + supporting text in the middle, trailing chevron_right.
    72dp tall per the M3 Expressive list treatment.

    The title and supporting text are bound at runtime by DriveActivity
    via the included layout's IDs (item_drive_gpio_title / _support).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/listitem_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:paddingHorizontal="@dimen/gap_medium">

    <FrameLayout
        android:layout_width="@dimen/listitem_icon_circle"
        android:layout_height="@dimen/listitem_icon_circle">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_icon_circle_primary" />

        <!-- Per R7 user choice: substitute pause icon with ic_tune. -->
        <ImageView
            android:layout_width="@dimen/listitem_icon_size"
            android:layout_height="@dimen/listitem_icon_size"
            android:layout_gravity="center"
            android:src="@drawable/ic_tune" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/card_image_text_gap"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_drive_gpio_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.S3.BodyLarge"
            android:textColor="?attr/colorOnSurface"
            android:lineSpacingMultiplier="1.3" />

        <TextView
            android:id="@+id/item_drive_gpio_support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.S3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:lineSpacingMultiplier="1.4" />
    </LinearLayout>

    <!-- Bật/tắt GPIO. Ấn vào phần còn lại của row = đặt tên. -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/item_drive_gpio_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_small" />
</LinearLayout>
