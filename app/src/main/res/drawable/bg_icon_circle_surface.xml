<?xml version="1.0" encoding="utf-8"?>
<!-- 40dp surface circle used as the leading icon background of the
     Threshold header (R7 spec: "leading warning icon (on a surface
     circle)"). The warning icon (ic_warning.xml) is tinted
     colorOnErrorContainer so it stands out on the surface circle,
     which itself sits on the secondaryContainer header background. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/surface" />
</shape>
