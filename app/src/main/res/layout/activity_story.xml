<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- 1. Top app bar (64dp on surface, extends behind status bar via inset). -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_bar"
        style="@style/Widget.Material3.Toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/topbar_height"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:title="@string/topbar_story"
        app:titleTextAppearance="@style/TextAppearance.S3.TitleLarge"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/action_back" />

    <!-- 6. Secondary nav bar pinned at the bottom. -->
    <include
        android:id="@+id/nav_bar_include"
        layout="@layout/layout_nav_bar_secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Body. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/nav_bar_include"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/gap_small"
            android:paddingBottom="@dimen/gap_large">

            <!-- 2. Outlined card (164dp) — image 123dp wide trailing side,
                 text centred. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.S3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="164dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:contentPadding="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/about_image"
                        android:layout_width="123dp"
                        android:layout_height="0dp"
                        android:contentDescription="@string/cd_image_placeholder"
                        android:background="?attr/colorSurfaceContainerHigh"
                        android:padding="36dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_image"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/about_headline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_image_text_gap"
                        android:text="@string/story_about_headline"
                        android:textAppearance="@style/TextAppearance.S3.TitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.3"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/about_body"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/about_image"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/about_body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_image_text_gap"
                        android:layout_marginTop="@dimen/card_text_gap"
                        android:text="@string/story_about_body"
                        android:textAppearance="@style/TextAppearance.S3.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.4"
                        app:layout_constraintTop_toBottomOf="@id/about_headline"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/about_image" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Divider with 16dp horizontal insets. -->
            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_medium"
                android:layout_marginStart="@dimen/divider_horizontal_inset"
                android:layout_marginEnd="@dimen/divider_horizontal_inset"
                app:dividerColor="?attr/colorOutlineVariant" />

            <!-- 4. 380x260dp box (surfaceContainerHigh, 28dp corners) with
                 text "Đoạn text này có thể sửa trước khi build" at 19sp
                 near the top. The text starts in an editable TextView for
                 now; the Activity wires it as a click-to-edit field so the
                 "có thể sửa" claim is honest even before the persistence
                 layer for it ships. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_medium"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_box_surface_high"
                android:padding="@dimen/gap_large">

                <TextView
                    android:id="@+id/editable_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:text="@string/story_editable_default"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:lineSpacingMultiplier="1.4"
                    android:clickable="false"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="@dimen/gap_small" />
            </FrameLayout>

            <!-- 5. List item "Web page" — leading open_in_new icon, tap
                 → opens https://laffeyzhieu.github.io/TaskList-Page/. -->
            <LinearLayout
                android:id="@+id/item_web_page"
                android:layout_width="match_parent"
                android:layout_height="@dimen/listitem_height"
                android:layout_marginTop="@dimen/gap_medium"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/colorSurfaceContainerLow"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:paddingHorizontal="@dimen/gap_medium">

                <FrameLayout
                    android:layout_width="@dimen/listitem_icon_circle"
                    android:layout_height="@dimen/listitem_icon_circle">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_icon_circle_primary" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="114dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_open_in_new" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/card_image_text_gap"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/story_web_page_title"
                        android:textAppearance="@style/TextAppearance.S3.BodyLarge"
                        android:textColor="?attr/colorOnSurface"
                        android:lineSpacingMultiplier="1.3" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/story_web_page_support"
                        android:textAppearance="@style/TextAppearance.S3.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:lineSpacingMultiplier="1.4" />
                </LinearLayout>

                <!-- No trailing chevron per spec (only leading open_in_new). -->
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
